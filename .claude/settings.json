{
  "permissions": {
    "allow": [
      "Bash(unity status *)",
      "Bash(unity command recompile_status *)",
      "Bash(unity command get_console_logs *)",
      "Bash(unity pipeline list)",
      "Bash(unity pipeline list *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/Tools/CloudEnv/license.sh\" auto",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
